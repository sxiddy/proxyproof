{
  "name": "proxyproof-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "simulate": "node --env-file-if-exists=.env src/simulate.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2"
  }
}
